# Supabase project (shared feedbackgb schema). Service-role key is server-only
# and must never reach the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App-scoped session signing secret. MUST be >=32 chars and DIFFERENT from the
# seller/admin SESSION_SECRET. Generate one with `npm run bootstrap:local-env`.
SUPPLY_SESSION_SECRET=

# household_chemicals.warehouses.id used as the consumables source warehouse.
# Defaults to 37 ("Склад витратних матеріалів") when unset.
CONSUMABLES_WAREHOUSE_ID=37
