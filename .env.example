# Supabase (server only — anon key not used by the app itself)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only key. Bypasses RLS — NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Telegram bot — used to validate initData (HMAC against bot token)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# HMAC key that signs the session cookie. Generate with:
#   openssl rand -hex 32
# REQUIRED in production. Must be different from SUPABASE_SERVICE_ROLE_KEY.
SESSION_SECRET=replace-me-with-32+-random-bytes

# v1 priority flow — product photos come from the POS CDN. `v_products.photo`
# stores a relative path like `/upload/pos_cdb_xxxxx/menu/product_xxx.jpeg`
# which the client prefixes with this base URL. Leave empty to render
# emoji/letter fallbacks in the picker.
NEXT_PUBLIC_POSTER_CDN_BASE_URL=https://joinposter.com

# Daily-report cron (sends a summary into a Telegram group at 21:30 Kyiv).
# Group chat id (negative for groups; supergroups start with -100).
TELEGRAM_REPORT_CHAT_ID=-1001234567890
# Bearer token Vercel Cron sends with each scheduled invocation.
# Generate with: openssl rand -base64 48
CRON_SECRET=replace-me-with-random-string

# Where 📷 in the daily report points to when clicked. Three modes:
#   supabase  (default) — short-lived signed URL on the Supabase Storage
#                          object. Works in any chat type. Links expire
#                          after ~7 days; older photos in chat history
#                          break after that.
#   drive     — link to the mirrored copy on Google Drive
#                (drive.google.com/file/d/<id>/view). Permanent, but
#                requires GOOGLE_DRIVE_FOLDER_ID to be shared with viewers.
#   telegram  — t.me/c/<chat>/<message_id> deep link to the photo message
#                inside the same chat. Best UX, but works ONLY when
#                TELEGRAM_REPORT_CHAT_ID is a supergroup (id starts with -100).
REPORT_PHOTO_LINK_MODE=supabase

# Google Drive backup (optional — when set, photos are mirrored into a folder
# you control). Leave both empty to disable the mirror.
# Folder id is the trailing path component in the Drive URL:
#   https://drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_FOLDER_ID=
# Full JSON content downloaded from Google Cloud Console
# (IAM & Admin → Service Accounts → <SA> → Keys → Add Key → Create new key → JSON).
# The service account email must have Editor access to GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_DRIVE_SA_KEY=

# PostHog product analytics (optional — leave empty to disable). Use the
# *Project* API key (phc_…), NOT the personal API key. This value ships in
# the client bundle so it is by definition public — PostHog Project keys
# are designed for this. Host defaults to the EU cloud; override only if
# you self-host or use the US cloud.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
