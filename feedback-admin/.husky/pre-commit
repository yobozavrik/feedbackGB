#!/usr/bin/env sh
# Pre-commit hook: scan staged changes for secrets and infra leaks.
#
# - Uses gitleaks with our project-specific config (.gitleaks.toml).
# - Only inspects what is actually staged for this commit (via `--staged`),
#   so it stays fast even on a large repo.
# - Skip with `git commit --no-verify` only if you know what you're doing.
#
# This project lives in a subdirectory of the git repo (feedback-admin/),
# but core.hooksPath makes git run hooks with the repo root as cwd. `cd`
# into this script's own directory first so the relative --config path
# below resolves correctly regardless of where git invoked us from.
cd "$(dirname "$0")/.." || exit 1

if ! command -v gitleaks >/dev/null 2>&1; then
  cat <<'EOF' >&2
[pre-commit] gitleaks is not installed.

Install it once and retry:
  macOS:    brew install gitleaks
  Debian:   sudo apt install gitleaks
  Other:    https://github.com/gitleaks/gitleaks/releases

To bypass this check (NOT recommended): git commit --no-verify
EOF
  exit 1
fi

gitleaks protect --staged --config=.gitleaks.toml --redact --verbose || exit 1

# Shared files must stay byte-identical between feedback-app and
# feedback-admin (see scripts/check-shared-drift.sh at the repo root).
sh ../scripts/check-shared-drift.sh
